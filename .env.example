# Base URL of your backend API that receives ESP PUT updates
# Example: http://192.168.1.100:5000 or https://api.mining-tracking.com
VITE_API_BASE_URL=http://localhost:5000

# Polling frequency in milliseconds to query the latest helmet data
VITE_POLLING_INTERVAL=1000

# Set to true only for local simulation testing without any backend running
VITE_USE_MOCK_DATA=false

# Inactivity timeout in milliseconds before a helmet is flagged as STALE/OFFLINE
VITE_STALE_TIMEOUT=10000

# Signal strength thresholds in dBm
VITE_SAFE_SIGNAL_THRESHOLD=-65
VITE_WARNING_SIGNAL_THRESHOLD=-75
VITE_CRITICAL_SIGNAL_THRESHOLD=-85
